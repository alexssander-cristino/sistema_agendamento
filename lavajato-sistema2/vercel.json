{
"version": 2,
"builds": [
{
"src": "api/index.js",
"use": "@vercel/node"
},
{
"src": "public/**",
"use": "@vercel/static"
}
],
"routes": [
{
"src": "/api/(.*)",
"dest": "/api/index.js"
},
{
"src": "/(.*\.(html|css|js|png|jpg|jpeg|svg|ico|webp))",
"headers": {
"cache-control": "public, max-age=0, must-revalidate"
},
"continue": true
},
{
"src": "/(.*)",
"dest": "/api/index.js"
}
]
}
